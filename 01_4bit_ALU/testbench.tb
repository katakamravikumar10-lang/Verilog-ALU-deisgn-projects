module tb;
  
  reg [3:0] a;
  reg [3:0] b;
  reg [2:0] sel;
  wire [3:0] y;
  
  alu_4bit dut(
    
    .a(a),
    .b(b),
    .sel(sel),
    .y(y)
  );
  
  initial begin
    
    $dumpfile("alu_4bit.vcd");
    $dumpvars(0,tb);
    $monitor("time=%0t, a=%b, b=%b, sel=%b, y=%b",
             $time,a,b,sel,y);
  end
  initial begin
    
    a = 4'b1010;
    b = 4'b0011;
    
    sel = 3'b000;
    #5;
    
    sel = 3'b001;
     #5;
    
    sel = 3'b010;
     #5;
    
    sel = 3'b011;
     #5;
    
    sel = 3'b100;
     #5;
    
    sel = 3'b101;
     #5;
    
    sel = 3'b110;
     #5;
    
    sel = 3'b111;
     #5;
    
    $finish;
    
  end
endmodule
    